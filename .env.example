# Copie este arquivo para ".env" e preencha com valores reais antes de rodar
# "docker compose up". O arquivo ".env" nunca deve ser commitado no Git.

# --- Banco de dados (Postgres compartilhado entre os serviços, um banco por serviço) ---
DB_USERNAME=siga
DB_PASSWORD=troque-esta-senha

# --- JWT: segredo compartilhado entre TODOS os serviços (gateway + microsserviços) ---
# Precisa ser o MESMO valor em todos os serviços, senão a validação do token
# gerado por um serviço falha ao ser validado por outro.
# Gere um valor forte, por exemplo: openssl rand -base64 48
JWT_SECRET=troque-este-segredo-por-um-valor-longo-e-aleatorio
JWT_EXPIRATION=1800000

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:8080
